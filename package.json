{
  "name": "malam-manifesto-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.js tests/*.test.ts tests/*.test.tsx tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps tests scripts vite.config.ts",
    "build": "vite build",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "start": "tsx apps/bridge/src/main.ts",
    "pair:setup": "python3 scripts/pair-setup.py",
    "validate:presets": "tsx scripts/validate-presets.ts",
    "obs:provision": "tsx scripts/provision-obs-scenes.ts",
    "audit:overflow": "tsx scripts/overflow-audit.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  }
}
