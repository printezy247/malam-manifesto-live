{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["packages/**/*", "apps/**/*", "fixtures/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"]
}
